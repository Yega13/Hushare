# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# OpenNext build output (contains baked-in env vars — never commit)
/.open-next/

# Wrangler local state and deploy temp files. The miniflare sqlite files are local dev
# emulator state; .wrangler/tmp holds the bundled worker, which is ~185k lines of build
# output and was committed by accident on 2026-08-17 by a `git add -A` during a failed deploy.
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secret dumps / credential files — never commit credentials
# (scoped to credential file extensions so source files like album-password.ts
#  and PasswordGate.tsx are never accidentally ignored)
*[Pp]assword*.txt
*[Pp]assword*.png
*[Pp]assword*.csv
*[Ss]ecret*.txt
*[Ss]ecret*.csv
*token*.txt
*[Aa]ccess[Kk]ey*.csv
*credentials*.csv
*.pem
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local session config / caches. Machine-specific, not project config.
/.claude/

# Security audit findings. Kept OUT of the repository: this repo is PUBLIC, and the audit
# documents unfixed vulnerabilities with file:line reproduction steps plus live database
# statistics. Publishing it would be handing over an exploit playbook for holes that are still
# open. Findings live in ~/.hushare-secrets/ until the issues they describe are closed.
/docs/

# Database dumps from scripts/backup-db.mjs. This repository is PUBLIC and a dump contains every
# owner token, every album password hash and every user email -- anyone holding one can open any
# private album. It is the single most dangerous file this project can produce, so it is ignored
# before the script that writes it was ever run.
/backups/

# Scratch scripts written while auditing — including by review subagents, which leave them behind
# when they are cut off mid-run. Three were committed by accident on 2026-08-28 (read-only query
# scripts, no secrets, but this repo is PUBLIC and nothing unreviewed should land in it).
.audit-*
_tmp-*
scripts/_tmp-*

# Scratch watchers, same reasoning as .audit-*
.watch-*
