# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cloudflare ──────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
# R2 S3-compatible credentials (Cloudflare dashboard → R2 → Manage API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public CDN domain for the R2 bucket (e.g. videos.hushare.space)
R2_PUBLIC_HOST=
# PRIVATE bucket for database dumps — REQUIRED by scripts/backup-upload.mjs, which refuses to run
# without it rather than guessing. It must NOT be the media bucket above: a dump holds every owner
# token and album password hash, and for ten nights it was written to the bucket served at
# R2_PUBLIC_HOST, publicly and unauthenticated. Any bucket with no custom domain and no r2.dev.
R2_BACKUP_BUCKET=hushare-db-backups

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com

# ─── Album security ──────────────────────────────────────────────────────────
# 32+ random base64 bytes. Rotate by setting ALBUM_PASSWORD_PEPPER_PREVIOUS to
# the old value and ALBUM_PASSWORD_PEPPER to the new value.
ALBUM_PASSWORD_PEPPER=
ALBUM_PASSWORD_PEPPER_PREVIOUS=
# 32+ random chars. Used to authenticate cron route calls from the Worker.
ALBUM_RETIREMENT_SECRET=

# ─── AWS Rekognition (Studio tier face search) ────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# ─── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Set to "true" only in production after verifying the domain in Resend
RESEND_DOMAIN_VERIFIED=false
MAILING_ADDRESS=
SUPPORT_EMAIL=

# ─── Polar (billing) ─────────────────────────────────────────────────────────
# Organization Access Token. Polar dashboard: Settings -> DEVELOPERS -> New Token
# (https://polar.sh/to/dashboard/settings). It is NOT called "API Keys" any more, which is
# exactly why it is hard to find.
#
# SCOPES ARE STAMPED IN AT CREATION. Editing an existing token does not change what it may do,
# so widening permissions means creating a NEW token and replacing this value. The token needs
# orders:read as well as the subscription/checkout/customer/product scopes -- without it the
# nightly reconcile-packages cron dies with 403 insufficient_scope, and a package payment whose
# webhook never arrived has NO repair path at all.
POLAR_API_KEY=
# Set to "true" to use sandbox.polar.sh instead of api.polar.sh
POLAR_SANDBOX=false
# Product IDs from your Polar dashboard
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_STUDIO_MONTHLY=
POLAR_PRODUCT_STUDIO_YEARLY=
# Optional first-month discount IDs
POLAR_DISCOUNT_PRO_FIRST_MONTH=
POLAR_DISCOUNT_STUDIO_FIRST_MONTH=
# Webhook secret(s) — rotate by setting PREVIOUS to the old value, SECRET to the new one
POLAR_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET_PREVIOUS=
